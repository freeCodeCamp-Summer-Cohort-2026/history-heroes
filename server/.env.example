# Application
PORT=3000
NODE_ENV=development

# Database (SQLite connection & configuration)
DATABASE_STORAGE=data/dev.sqlite

# this enables the typeorm/server code to automatically remap the database,
# this can delete data depending on what you are doing, but locally this should be OK due to
# the existence of the seeding mechanism
DATABASE_SYNCHRONIZE=true

# Session
SESSION_SECRET=holy-cow-wowy-zowy-this-is-security-session-secret-hash-mash-monster-mash-halloween-is-soon-i-need-to-get-candy-ok-this-is-long-enough-my-goodness
# 1 year in milliseconds (365 * 24 * 60 * 60 * 1000)
SESSION_MAX_AGE=31536000000
