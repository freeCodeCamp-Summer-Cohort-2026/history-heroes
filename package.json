{
  "name": "history-heroes",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf dist",
    "compose-prod-build": "node scripts/compose-prod-build.js"
  },
  "license": "MIT",
  "lint-staged": {
    "client/**/*.{ts,tsx,js,jsx}": [
      "npx --prefix client eslint --fix",
      "prettier --write"
    ],
    "client/**/*.{json,css,html,md}": [
      "prettier --write"
    ],
    "server/**/*.ts": [
      "npx --prefix server oxlint",
      "prettier --write"
    ],
    "server/**/*.{json,md}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "rimraf": "^6.1.3"
  }
}
